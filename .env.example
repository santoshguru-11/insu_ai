# ---------------------------------------------------------------------------
# Autonomous Maintenance Console — example environment file
#
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Deployment environment: local | dev | staging | prod
APP_ENV=local

# Human-readable application name (used in logs and the /health payload)
APP_NAME=Autonomous Maintenance Console

# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Async SQLAlchemy connection string (asyncpg driver).
# Must match the credentials used by docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://amc:change-me-locally@localhost:5432/amc

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Prefix mounted in front of every versioned API route.
API_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Consumed by docker-compose.yml when starting the local PostgreSQL container.
# ---------------------------------------------------------------------------
POSTGRES_USER=amc
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=amc
POSTGRES_PORT=5432
